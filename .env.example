# Flagsmith Server-Side Environment Key
FLAGSMITH_ENVIRONMENT_KEY=ser.your_server_side_key_here

# Flask Application Secret Key (generate via `python3 -c "import secrets; print(secrets.token_hex(32))"`)
FLASK_SECRET_KEY=change_me

# Flask Debug Mode (set to 'true' only for local development debugging)
FLASK_DEBUG=false

# Port
PORT=5001
